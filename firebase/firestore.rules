rules_version = '2';

// Regras de acesso do AdonaiApp.
//
// Princípios:
//  - Somente administradores alteram elenco, roteiro, peças e ensaios.
//  - Participantes leem os dados da produção e editam apenas telefone e foto
//    do próprio cadastro.
//  - `people` é lido por todo o elenco, porque a lista de elenco precisa de
//    nome e foto. Por isso o que é pessoal — e-mail, telefone, nascimento e o
//    contato do responsável — não mora ali: fica em
//    `people/{id}/privado/contato`, que só a direção e a própria pessoa leem.
//    Dentro dele, o e-mail é o único campo que a pessoa não escreve: é por ele
//    que a direção reconhece quem é quem ao ligar uma conta a uma ficha.
//  - As observações internas da direção ficam em `people/{id}/privado/*`, e as
//    características de atuação em `direcao/caracteristicas` — ambas fora do
//    alcance dos participantes, que leem `people` e `characters`.
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function temConta() {
      return autenticado()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function conta() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function ehAdmin() {
      return temConta() && conta().role == 'admin';
    }

    // ----------------------------------------------------------- contas

    match /users/{uid} {
      allow get, list: if autenticado() && (request.auth.uid == uid || ehAdmin());

      // Cada integrante cria a própria conta, sempre como participante e
      // sempre sem vínculo. Administradores são promovidos pelo script
      // `npm run admin`; o vínculo com a ficha é da direção, em Pessoas, ou
      // vem pronto no convite — que é gravado por função com credencial de
      // servidor e não passa por aqui.
      //
      // Antes esta regra aceitava um `personId` cujo cadastro tivesse o mesmo
      // e-mail do token. Era o resquício do vínculo automático, que saiu do
      // app justamente porque atribuía o histórico de alguém por coincidência
      // de texto num campo que a própria pessoa escolhe.
      allow create: if autenticado()
        && request.auth.uid == uid
        && request.resource.data.role == 'participante'
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.personId == null;

      // A conta cuida do que é dela — nome, tokens de aviso. `role` e
      // `personId` ficam como estão: sem isto a pessoa podia zerar o próprio
      // vínculo e sair da ficha em que a direção a colocou, o que a deixava na
      // tela de "sem vínculo" e liberava a ficha para um convite novo.
      allow update: if ehAdmin()
        || (autenticado()
            && request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.personId == resource.data.personId);

      allow delete: if ehAdmin();
    }

    // ---------------------------------------------------------- pessoas

    match /people/{personId} {
      // O elenco precisa se enxergar; o cadastro em si é da direção.
      allow get, list: if autenticado();
      allow create, delete: if ehAdmin();
      // A pessoa mantém os próprios dados e responde o cadastro de primeiro
      // acesso. Fora desta lista nada muda: `ativo` é decisão do grupo e
      // `caracteristicas` é avaliação da direção.
      //
      // Telefone, nascimento, responsável e e-mail saíram desta lista: agora
      // moram em `privado/contato`. Aqui ficou o que a lista de elenco mostra.
      allow update: if ehAdmin()
        || (temConta()
            && conta().personId == personId
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly([
                 'nome',
                 'fotoUrl',
                 // A miniatura sobe junto com a foto, na mesma gravação. Sem
                 // ela aqui, trocar de foto era negado por inteiro.
                 'fotoMiniUrl',
                 'jaAtuou',
                 'experiencia',
                 'pecasAnteriores',
                 'cadastroCompletoEm'
               ]));

      match /privado/{documento} {
        function ehAPropriaPessoa() {
          return temConta() && conta().personId == personId;
        }
        /*
         * `contato` é da pessoa: ela responde no primeiro acesso e edita no
         * Perfil, e a direção precisa ver para falar com ela e para saber de
         * quem é o responsável. Qualquer outro documento aqui — as observações
         * internas — segue exclusivo da direção.
         */
        allow read: if ehAdmin() || (documento == 'contato' && ehAPropriaPessoa());

        /*
         * O e-mail mora aqui mas continua sendo da direção.
         *
         * Ele saiu da ficha pública porque ninguém precisa do endereço de todo
         * mundo, não porque virou campo editável: é por ele que a direção
         * reconhece quem é quem ao ligar uma conta a uma ficha. Deixar a
         * própria pessoa reescrevê-lo daria a ela como a direção a identifica.
         *
         * Criar e alterar são separados porque `resource` não existe antes do
         * primeiro documento — `diff` contra nada é erro, e erro aqui é
         * recusa: o cadastro de primeiro acesso, que é justamente quem cria
         * este documento, pararia de gravar.
         *
         * Na alteração, `hasAny` olha se a gravação mexeu na chave, não o
         * valor. Regravar o mesmo e-mail não afeta chave nenhuma e passa — e
         * está certo, porque não mudou nada.
         */
        allow create: if ehAdmin()
          || (documento == 'contato'
              && ehAPropriaPessoa()
              && !('email' in request.resource.data));

        allow update: if ehAdmin()
          || (documento == 'contato'
              && ehAPropriaPessoa()
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['email']));

        // Apagar o contato é da direção. Nenhuma tela do participante faz
        // isso, e perder telefone e responsável por engano não tem volta.
        allow delete: if ehAdmin();
      }
    }

    // ------------------------------------------------- características

    /*
     * Vocabulário de avaliação da direção. Fechado para o participante: as
     * telas dele não mostram mais característica nenhuma, então não há motivo
     * para o cliente conseguir baixar os rótulos.
     */
    match /traits/{traitId} {
      allow read, write: if ehAdmin();
    }

    /*
     * Quem tem qual característica, e o que cada papel pede.
     *
     * Fica aqui, e não em `people` ou `characters`, porque essas duas são
     * legíveis por qualquer autenticado — o participante precisa delas para
     * ver nomes em convocação, presença e elenco. Guardar a avaliação junto
     * significava entregá-la a quem abrisse as ferramentas do navegador.
     */
    match /direcao/{documento} {
      allow read, write: if ehAdmin();
    }

    // ------------------------------------------------------------ peças

    match /plays/{playId} {
      allow get, list: if autenticado();
      allow write: if ehAdmin();

      match /characters/{characterId} {
        allow get, list: if autenticado();
        allow write: if ehAdmin();
      }

      match /lines/{lineId} {
        allow get, list: if autenticado();
        allow write: if ehAdmin();
      }
    }

    // --------------------------------------------------------- ensaios

    match /rehearsals/{rehearsalId} {
      allow get, list: if autenticado();
      allow write: if ehAdmin();

      // Confirmação de presença. O id do documento é o da pessoa, então cada
      // uma só escreve na própria resposta; a direção pode corrigir qualquer
      // uma. Todo o elenco lê, para saber quem confirmou.
      //
      // O ensaio precisa existir. Sem essa checagem dava para gravar resposta
      // em ensaio inventado — o Firestore aceita subcoleção sob documento que
      // não existe —, e era uma torneira aberta de documentos que ninguém
      // nunca leria.
      match /presencas/{personId} {
        allow get, list: if autenticado();
        allow write: if exists(/databases/$(database)/documents/rehearsals/$(rehearsalId))
          && (ehAdmin() || (temConta() && conta().personId == personId));
      }
    }

    // ----------------------------------------------------------- avisos

    // Só a direção compõe e consulta os avisos. Quem entrega é o disparador,
    // que usa credencial de servidor e não passa por estas regras.
    match /avisos/{avisoId} {
      allow read, write: if ehAdmin();
    }

    // ------------------------------------------------- exercícios
    // Todo o elenco lê; só a direção monta a lista. Não há nada de pessoal
    // aqui: é o mesmo material de preparação para todos.
    match /exercicios/{exercicioId} {
      allow get, list: if autenticado();
      allow write: if ehAdmin();
    }

    // --------------------------------------------------- convites
    // Só a direção gera e enxerga os convites. Quem resgata é uma função com
    // credencial de servidor, que não passa por estas regras — por isso quem
    // ainda não tem conta não precisa de leitura nenhuma aqui, e o código não
    // fica exposto a quem sabe consultar a coleção.
    /*
     * Contagem de tentativas das funções abertas (conferir e resgatar
     * convite). Só o servidor escreve e lê — nenhuma tela precisa disso, e
     * deixar o cliente alcançar o contador seria deixá-lo zerar o próprio
     * limite. Sem `allow`, o Firestore recusa por padrão; o bloco existe para
     * isso ficar dito e não parecer esquecimento.
     */
    match /limites/{chave} {
      allow read, write: if false;
    }

    match /convites/{codigo} {
      allow get, list: if ehAdmin();
      // Só `create`: um código nunca é reescrito. Se o sorteio repetir um
      // código já existente, a gravação falha em vez de sobrescrever o convite
      // de outra pessoa — e o cliente sorteia outro.
      allow create: if ehAdmin();
      allow update: if false;
      allow delete: if ehAdmin();
    }

    // --------------------------------------------------- participações

    match /participations/{participationId} {
      allow get, list: if autenticado();
      allow write: if ehAdmin();
    }
  }
}
