# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Conta de servico do Firebase usada pelos scripts de administracao.
# Os padroes cobrem o nome que o console gera, que comeca com o id do projeto.
*firebase-adminsdk*.json
*serviceaccount*.json
*service-account*.json

# Cache local do Firebase CLI (.firebaserc é versionado)
.firebase/
